[Interface]
Address = {{ yandex_direct_wg_client_address }}
ListenPort = {{ yandex_direct_wg_client_listen_port }}
PrivateKey = {{ yandex_direct_wg_client_private_key_resolved }}

{% for peer in yandex_direct_wg_client_peers %}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
