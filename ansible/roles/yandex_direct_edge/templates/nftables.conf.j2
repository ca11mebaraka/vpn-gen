#!/usr/sbin/nft -f
flush ruleset

table inet filter {
  chain input {
    type filter hook input priority filter; policy accept;
    udp dport { {{ yandex_direct_wg_client_listen_port }}, {{ yandex_direct_wg_transit_listen_port }} } counter accept
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "{{ yandex_direct_wg_client_interface }}" oifname "{{ yandex_direct_wg_transit_interface }}" ip saddr {{ yandex_direct_client_cidr }} counter accept
    iifname "{{ yandex_direct_wg_transit_interface }}" oifname "{{ yandex_direct_wg_client_interface }}" ip daddr {{ yandex_direct_client_cidr }} ct state established,related counter accept
  }
}
