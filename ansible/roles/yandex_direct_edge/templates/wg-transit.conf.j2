[Interface]
Address = {{ yandex_direct_wg_transit_address }}
ListenPort = {{ yandex_direct_wg_transit_listen_port }}
PrivateKey = {{ yandex_direct_wg_transit_private_key_resolved }}
Table = off
PostUp = ip rule add from {{ yandex_direct_client_cidr }} table {{ yandex_direct_policy_table }} priority {{ yandex_direct_policy_rule_priority }} 2>/dev/null || true
PostUp = ip route replace default dev %i table {{ yandex_direct_policy_table }}
PostUp = ip route replace {{ yandex_direct_racknerd_transit_address }} dev %i
PostDown = ip route del {{ yandex_direct_racknerd_transit_address }} dev %i 2>/dev/null || true
PostDown = ip route del default dev %i table {{ yandex_direct_policy_table }} 2>/dev/null || true
PostDown = ip rule del from {{ yandex_direct_client_cidr }} table {{ yandex_direct_policy_table }} priority {{ yandex_direct_policy_rule_priority }} 2>/dev/null || true

[Peer]
PublicKey = {{ yandex_direct_racknerd_public_key }}
Endpoint = {{ yandex_direct_racknerd_endpoint }}
AllowedIPs = {{ yandex_direct_racknerd_allowed_ips | join(', ') }}
PersistentKeepalive = {{ yandex_direct_racknerd_persistent_keepalive }}
