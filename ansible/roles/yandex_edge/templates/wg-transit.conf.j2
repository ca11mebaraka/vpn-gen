[Interface]
Address = {{ yandex_edge_wg_transit_address }}
ListenPort = {{ yandex_edge_wg_transit_listen_port }}
PrivateKey = {{ yandex_edge_wg_transit_private_key_resolved }}
Table = off
PostUp = ip rule add fwmark {{ yandex_edge_policy_fwmark }} table {{ yandex_edge_policy_table }} priority {{ yandex_edge_policy_rule_priority }} 2>/dev/null || true
PostUp = ip route replace default dev %i table {{ yandex_edge_policy_table }}
PostDown = ip route del default dev %i table {{ yandex_edge_policy_table }} 2>/dev/null || true
PostDown = ip rule del fwmark {{ yandex_edge_policy_fwmark }} table {{ yandex_edge_policy_table }} priority {{ yandex_edge_policy_rule_priority }} 2>/dev/null || true

[Peer]
PublicKey = {{ yandex_edge_racknerd_wg_transit_public_key }}
Endpoint = {{ yandex_edge_racknerd_wg_transit_endpoint }}
AllowedIPs = {{ yandex_edge_racknerd_allowed_ips | join(', ') }}
PersistentKeepalive = {{ yandex_edge_racknerd_persistent_keepalive }}
