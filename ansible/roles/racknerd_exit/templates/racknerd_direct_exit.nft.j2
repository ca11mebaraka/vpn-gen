table inet racknerd_direct_exit {
  chain input {
    type filter hook input priority filter; policy accept;

    udp dport {{ racknerd_direct_exit_wg_listen_port }} counter accept
  }

  chain forward {
    type filter hook forward priority filter; policy accept;

    iifname "{{ racknerd_direct_exit_wg_interface }}" oifname "{{ racknerd_exit_public_interface }}" ip saddr {{ racknerd_direct_exit_client_cidr }} counter accept
    iifname "{{ racknerd_exit_public_interface }}" oifname "{{ racknerd_direct_exit_wg_interface }}" ip daddr {{ racknerd_direct_exit_client_cidr }} ct state established,related counter accept
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;

    oifname "{{ racknerd_exit_public_interface }}" ip saddr {{ racknerd_direct_exit_client_cidr }} counter masquerade
  }
}
