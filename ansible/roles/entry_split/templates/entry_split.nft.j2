table inet entry_split {
  set ru4 {
    type ipv4_addr
    flags interval
{% if entry_split_ru_ipv4_cidrs | length > 0 %}
    elements = {
{% for cidr in entry_split_ru_ipv4_cidrs %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
{% endif %}
  }

  set bypass4 {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in entry_split_bypass_ipv4_cidrs %}
      {{ cidr }}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }

  chain input {
    type filter hook input priority filter; policy accept;

    udp dport { {{ entry_split_wg_client_listen_port }}, {{ entry_split_wg_transit_listen_port }}{% if entry_split_dual_exit_enabled %}, {{ entry_split_wg_client_2_listen_port }}, {{ entry_split_wg_transit_2_listen_port }}{% endif %} } counter accept
{% if entry_split_dns_enabled %}
    iifname "{{ entry_split_wg_client_interface }}" ip saddr {{ entry_split_client_cidr }} udp dport 53 counter accept
    iifname "{{ entry_split_wg_client_interface }}" ip saddr {{ entry_split_client_cidr }} tcp dport 53 counter accept
{% if entry_split_dual_exit_enabled %}
    iifname "{{ entry_split_wg_client_2_interface }}" ip saddr {{ entry_split_client_2_cidr }} udp dport 53 counter accept
    iifname "{{ entry_split_wg_client_2_interface }}" ip saddr {{ entry_split_client_2_cidr }} tcp dport 53 counter accept
{% endif %}
{% endif %}
  }

  chain mark_client_traffic {
    type filter hook prerouting priority mangle; policy accept;

    iifname "{{ entry_split_wg_client_interface }}" ip saddr {{ entry_split_client_cidr }} ip daddr != @ru4 ip daddr != @bypass4 counter meta mark set {{ entry_split_policy_fwmark }}
{% if entry_split_dual_exit_enabled %}
    iifname "{{ entry_split_wg_client_2_interface }}" ip saddr {{ entry_split_client_2_cidr }} ip daddr != @ru4 ip daddr != @bypass4 counter meta mark set {{ entry_split_policy_fwmark_exit2 }}
{% endif %}
  }

  chain forward {
    type filter hook forward priority filter; policy accept;

    iifname "{{ entry_split_wg_client_interface }}" oifname "{{ entry_split_public_interface }}" ip saddr {{ entry_split_client_cidr }} counter accept
    iifname "{{ entry_split_wg_client_interface }}" oifname "{{ entry_split_wg_transit_interface }}" ip saddr {{ entry_split_client_cidr }} meta mark {{ entry_split_policy_fwmark }} counter accept
    iifname "{{ entry_split_public_interface }}" oifname "{{ entry_split_wg_client_interface }}" ip daddr {{ entry_split_client_cidr }} ct state established,related counter accept
    iifname "{{ entry_split_wg_transit_interface }}" oifname "{{ entry_split_wg_client_interface }}" ip daddr {{ entry_split_client_cidr }} ct state established,related counter accept
{% if entry_split_dual_exit_enabled %}
    iifname "{{ entry_split_wg_client_2_interface }}" oifname "{{ entry_split_public_interface }}" ip saddr {{ entry_split_client_2_cidr }} counter accept
    iifname "{{ entry_split_wg_client_2_interface }}" oifname "{{ entry_split_wg_transit_2_interface }}" ip saddr {{ entry_split_client_2_cidr }} meta mark {{ entry_split_policy_fwmark_exit2 }} counter accept
    iifname "{{ entry_split_public_interface }}" oifname "{{ entry_split_wg_client_2_interface }}" ip daddr {{ entry_split_client_2_cidr }} ct state established,related counter accept
    iifname "{{ entry_split_wg_transit_2_interface }}" oifname "{{ entry_split_wg_client_2_interface }}" ip daddr {{ entry_split_client_2_cidr }} ct state established,related counter accept
{% endif %}
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;

    oifname "{{ entry_split_public_interface }}" ip saddr {{ entry_split_client_cidr }} counter masquerade
{% if entry_split_dual_exit_enabled %}
    oifname "{{ entry_split_public_interface }}" ip saddr {{ entry_split_client_2_cidr }} counter masquerade
{% endif %}
  }
}
