[Interface]
Address = {{ entry_split_wg_transit_address }}
ListenPort = {{ entry_split_wg_transit_listen_port }}
PrivateKey = {{ entry_split_wg_transit_private_key_resolved }}
Table = off
PostUp = ip rule add fwmark {{ entry_split_policy_fwmark }} table {{ entry_split_policy_table }} priority {{ entry_split_policy_rule_priority }} 2>/dev/null || true
PostUp = ip route replace default dev %i table {{ entry_split_policy_table }}
PostDown = ip route del default dev %i table {{ entry_split_policy_table }} 2>/dev/null || true
PostDown = ip rule del fwmark {{ entry_split_policy_fwmark }} table {{ entry_split_policy_table }} priority {{ entry_split_policy_rule_priority }} 2>/dev/null || true

[Peer]
PublicKey = {{ entry_split_exit_wg_transit_public_key }}
Endpoint = {{ entry_split_exit_wg_transit_endpoint }}
AllowedIPs = {{ entry_split_exit_allowed_ips | join(', ') }}
PersistentKeepalive = {{ entry_split_exit_persistent_keepalive }}
