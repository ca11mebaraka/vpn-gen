table inet vpn_exit {
  set admin4 {
    type ipv4_addr
    flags interval
    elements = { {% if exit_allow_world_ssh %}0.0.0.0/0{% else %}{{ exit_admin_ipv4_cidrs | join(', ') }}{% endif %} }
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state invalid drop
    ct state established,related accept
    ip saddr @admin4 tcp dport {{ exit_ssh_port }} counter accept
    ip saddr {{ exit_entry_public_ipv4 }} udp dport {{ exit_wg_transit_listen_port }} counter accept
{% if exit_entry_full_enabled %}
    udp dport {{ exit_entry_full_wg_listen_port }} counter accept
{% endif %}
    ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-request } limit rate 10/second accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state invalid drop
    ct state established,related accept
    iifname "{{ exit_wg_transit_interface }}" oifname "{{ exit_public_interface }}" ip saddr {{ exit_client_cidr }} counter accept
{% if exit_entry_full_enabled %}
    iifname "{{ exit_entry_full_wg_interface }}" oifname "{{ exit_public_interface }}" ip saddr {{ exit_entry_full_client_cidr }} counter accept
{% endif %}
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "{{ exit_public_interface }}" ip saddr {{ exit_client_cidr }} counter masquerade
{% if exit_entry_full_enabled %}
    oifname "{{ exit_public_interface }}" ip saddr {{ exit_entry_full_client_cidr }} counter masquerade
{% endif %}
  }
}
