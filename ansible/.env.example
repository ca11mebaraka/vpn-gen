# Универсальный шаблон для любого провайдера (VPS, Hetzner, OVH, …).
#   cp .env.example .env
#   source scripts/load-env.sh
#
# Частный случай Yandex + Racknerd: deployments/yandex-racknerd/.env.example

# --- Каталоги на Mac (по умолчанию $HOME/.config/vpn-gen/...) ---
# VPN_GEN_CONFIG_DIR=$HOME/.config/vpn-gen
# VPN_GEN_WG_SECRET_DIR=$HOME/.config/vpn-gen/wireguard
# VPN_GEN_WG_PUBLIC_VARS_FILE=$HOME/.config/vpn-gen/wireguard/public-vars.yml
# VPN_GEN_WG_ENTRY_FULL_SECRET_DIR=$HOME/.config/vpn-gen/wireguard-entry-full
# VPN_GEN_GEO_DIR=$HOME/.config/vpn-gen/geo
# VPN_GEN_RU_ZONE_FILE=$HOME/.config/vpn-gen/geo/ru.zone
# VPN_GEN_CLIENT_ADMIN_DIR=$HOME/.config/vpn-gen/wg-client-admin
# VPN_GEN_CLIENT_EXPORT_DIR=$HOME/Downloads

# --- Деплой ---
VPN_GEN_DEPLOYMENT=my-vpn

# Публичные IP (подставьте свои; ниже — примеры TEST-NET-3)
VPN_GEN_ENTRY_SPLIT_HOST=203.0.113.10
VPN_GEN_ENTRY_FULL_HOST=203.0.113.11
VPN_GEN_EXIT_HOST=198.51.100.20

# SSH: на большинстве VPS один пользователь deploy на всех узлах
VPN_GEN_ENTRY_SPLIT_SSH_USER=deploy
VPN_GEN_ENTRY_FULL_SSH_USER=deploy
VPN_GEN_EXIT_SSH_USER=deploy
VPN_GEN_SSH_KEY_ENTRY=~/.ssh/vpn-gen_ed25519
VPN_GEN_SSH_KEY_EXIT=~/.ssh/vpn-gen_ed25519

# Обязательно: публичный IP управляющего сервера в формате /32.
# Несколько адресов разделяются запятыми. 0.0.0.0/0 запрещён по умолчанию.
VPN_GEN_ADMIN_IPV4_CIDRS=CHANGE_ME/32
VPN_GEN_SSH_PORT=22
VPN_GEN_ALLOW_WORLD_SSH=false
VPN_GEN_SSH_KNOWN_HOSTS=$HOME/.config/vpn-gen/ssh/known_hosts

# Сверяются с fingerprints в панели провайдера перед первым Ansible SSH.
VPN_GEN_ENTRY_SSH_HOST_FINGERPRINT=SHA256:CHANGE_ME
VPN_GEN_EXIT_SSH_HOST_FINGERPRINT=SHA256:CHANGE_ME

# WireGuard endpoints
VPN_GEN_WG_CLIENT_ENDPOINT_HOST=203.0.113.10
VPN_GEN_WG_CLIENT_ENDPOINT_PORT=53774
VPN_GEN_EXIT_TRANSIT_PORT=51821
VPN_GEN_EXIT_FULL_PORT=51946
VPN_GEN_ENTRY_FULL_CLIENT_PORT=51944

# split + exit только: false. split + full + exit (3 узла): true
VPN_GEN_EXIT_ENTRY_FULL_ENABLED=false
