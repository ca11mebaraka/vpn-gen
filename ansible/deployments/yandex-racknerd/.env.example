# Частный reference-деплой: cloud.ru split entry + Yandex full entry + dual exit.
#   cp deployments/yandex-racknerd/.env.example ansible/.env
#   source scripts/load-env.sh
#
# yc-user — дефолтный пользователь Yandex Cloud на entry_full; split entry на cloud.ru — user1.

VPN_GEN_DEPLOYMENT=yandex-racknerd

# Split entry (cloud.ru, dual-exit)
VPN_GEN_ENTRY_SPLIT_HOST=176.123.164.26
VPN_GEN_ENTRY_SPLIT_SSH_USER=user1

# Full entry (Yandex Cloud)
VPN_GEN_ENTRY_FULL_HOST=89.169.158.239
VPN_GEN_ENTRY_FULL_SSH_USER=yc-user

# Exit lane 1 (Racknerd) + full entry transit
VPN_GEN_EXIT_HOST=172.245.154.109
VPN_GEN_EXIT_SSH_USER=deploy

# Exit lane 2 (split lane 2)
VPN_GEN_EXIT2_HOST=87.199.207.184
VPN_GEN_EXIT2_SSH_USER=root

VPN_GEN_SSH_KEY_ENTRY=~/.ssh/yc_vm_ed25519
VPN_GEN_SSH_KEY_EXIT=~/.ssh/vps_172_245_154_109_ed25519
VPN_GEN_SSH_KEY_EXIT2=~/.ssh/yc_vm_ed25519

# WireGuard ports
VPN_GEN_WG_CLIENT_ENDPOINT_HOST=176.123.164.26
VPN_GEN_WG_CLIENT_ENDPOINT_PORT=53774
VPN_GEN_ENTRY_SPLIT_CLIENT_PORT_2=54774
VPN_GEN_ENTRY_SPLIT_TRANSIT_PORT=51821
VPN_GEN_ENTRY_SPLIT_TRANSIT_PORT_2=49249
VPN_GEN_EXIT_TRANSIT_PORT=51821
VPN_GEN_EXIT2_TRANSIT_PORT=51821
VPN_GEN_EXIT_FULL_PORT=51946
VPN_GEN_ENTRY_FULL_CLIENT_PORT=51944

# exit_01 обслуживает и split lane 1, и full entry
VPN_GEN_EXIT_ENTRY_FULL_ENABLED=true

# VPN_GEN_ENTRY_SPLIT_INTERNAL_IP=...
# VPN_GEN_ENTRY_FULL_INTERNAL_IP=10.128.0.22
