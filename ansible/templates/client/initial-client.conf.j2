# Generated by ansible/playbooks/client_config.yml.
# PrivateKey is read from wireguard_initial_client_private_key_path on the local controller.

[Interface]
PrivateKey = {{ lookup('ansible.builtin.file', wireguard_initial_client_private_key_path) | trim }}
Address = {{ wireguard_initial_client_address }}
DNS = {{ wireguard_initial_client_dns }}
{% if wireguard_initial_client_mtu is defined and wireguard_initial_client_mtu | string | length > 0 %}
MTU = {{ wireguard_initial_client_mtu }}
{% endif %}

[Peer]
PublicKey = {{ wireguard_entry_split_wg_client_public_key }}
Endpoint = {{ wireguard_entry_split_client_endpoint_host }}:{{ wireguard_entry_split_client_endpoint_port }}
AllowedIPs = {{ wireguard_client_allowed_ips }}
PersistentKeepalive = 25
