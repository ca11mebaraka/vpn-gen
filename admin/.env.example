MYVPN_ADMIN_TELEGRAM_BOT_TOKEN=
MYVPN_ADMIN_TELEGRAM_IDS=CHANGE_ME_TELEGRAM_ID
MYVPN_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
MYVPN_ADMIN_COOKIE_SECURE=true
MYVPN_ADMIN_DB=/app/data/admin.db
MYVPN_ADMIN_HOST=myvpn.example.com
MYVPN_AUTH_BRIDGE_HOST=auth.example.com
MYVPN_ADMIN_PUBLIC_ORIGIN=https://myvpn.example.com
MYVPN_AUTH_BRIDGE_ORIGIN=https://auth.example.com
MYVPN_SHARED_AUTH_ENV=.env
MYVPN_REPO_ROOT=/workspace
MYVPN_ANSIBLE_DIR=/workspace/ansible
MYVPN_CLIENT_ADMIN_DIR=/run/myvpn/client-admin
MYVPN_CLIENT_EXPORT_DIR=/run/myvpn/client-exports
MYVPN_SSH_KNOWN_HOSTS=/run/myvpn/ssh/known_hosts
MYVPN_SSH_HOST_DIR=./secrets/ssh
MYVPN_SSH_DIR=/run/myvpn/ssh
MYVPN_CLIENT_ADMIN_HOST_DIR=./secrets/client-admin
MYVPN_CLIENT_EXPORT_HOST_DIR=./secrets/client-exports
MYVPN_CONTROLLER_NAME=controller
MYVPN_DEPLOYMENT=reference
MYVPN_ENTRY_HOST=CHANGE_ME_ENTRY_IP
MYVPN_EXIT_HOST=CHANGE_ME_EXIT_IP
MYVPN_INITIAL_OWNER=Initial owner
